// EJEMPLO ESTRUCTURA CONDICIONAL
import java.util.Scanner;

public class EstructuraCondicional {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		System.out.println("Ingrese su edad: ");
		int edad = sc.nextInt();
		// Estructura condicional
		if(edad>=18) { // Si la variable edad es mayor o igual a 18
			// Entonces ...
			System.out.println("Felicidades ya eres mayor de edad.");
		}
		else { // Sino
			// Entonces ...
			System.out.println("Aun no eres mayor de edad :(");
		}
	}
}
